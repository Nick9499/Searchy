# Production Environment Template
NODE_ENV=production
PORT=5000

# Database
DB_USER=postgres
DB_PASSWORD=your_strong_production_password_here
DB_NAME=searchy

# Security
JWT_SECRET=generate_a_random_64_character_hex_secret_here

# AWS S3 (Production Object Storage)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-searchy-production-bucket
AWS_ACCESS_KEY_ID=your_aws_iam_access_key
AWS_SECRET_ACCESS_KEY=your_aws_iam_secret_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/integrations/google/callback

# SMTP (Production Email)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@your-domain.com
