meta {
  name: 2FA Enable
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/users/2fa/enable
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "123456"
  }
}

script:post-response {
  if (res.body && res.body.recoveryCodes) {
    bru.setEnvVar("recoveryCodes", JSON.stringify(res.body.recoveryCodes));
  }
}
